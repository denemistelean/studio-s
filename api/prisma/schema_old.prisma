// Tabla confirmada en MariaDB: usuarios_admin (automot1_studios).
// No ejecutar migrate ni db push: este esquema solo describe la tabla existente.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UsuariosAdminEstado {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

model UsuariosAdmin {
  idUsuario      BigInt              @id @default(autoincrement()) @map("id_usuario")
  idRol          BigInt              @map("id_rol")
  nombres        String              @db.VarChar(100)
  apellidos      String              @db.VarChar(100)
  email          String              @unique @db.VarChar(150)
  passwordHash   String              @map("password_hash") @db.VarChar(255)
  estado         UsuariosAdminEstado
  ultimoAccesoEn DateTime?           @map("ultimo_acceso_en") @db.DateTime(0)
  creadoEn       DateTime            @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn  DateTime            @default(now()) @updatedAt @map("actualizado_en") @db.Timestamp(0)

  @@map("usuarios_admin")
}
