generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model UsuariosAdmin {
  idUsuario            BigInt                 @id @default(autoincrement()) @map("id_usuario") @db.UnsignedBigInt
  idRol                BigInt                 @map("id_rol") @db.UnsignedBigInt
  nombres              String                 @db.VarChar(100)
  apellidos            String                 @db.VarChar(100)
  email                String                 @unique(map: "uk_usuarios_admin_email") @db.VarChar(150)
  passwordHash         String                 @map("password_hash") @db.VarChar(255)
  estado               UsuariosAdminEstado    @default(ACTIVO)
  ultimoAccesoEn       DateTime?              @map("ultimo_acceso_en") @db.DateTime(0)
  creadoEn             DateTime               @default(now()) @map("creado_en") @db.Timestamp(0)
  actualizadoEn        DateTime               @default(now()) @updatedAt @map("actualizado_en") @db.Timestamp(0)
  auditoria            auditoria[]
  canjes_recompensas   canjes_recompensas[]
  movimientos_puntos   movimientos_puntos[]
  servicios_realizados servicios_realizados[]
  roles                roles                  @relation(fields: [idRol], references: [id_rol], onUpdate: Restrict, map: "fk_usuarios_admin_rol")

  @@index([estado], map: "idx_usuarios_admin_estado")
  @@index([idRol], map: "idx_usuarios_admin_rol")
  @@map("usuarios_admin")
}

model auditoria {
  id_auditoria     BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario_admin BigInt?        @db.UnsignedBigInt
  accion           String         @db.VarChar(100)
  tabla_afectada   String?        @db.VarChar(100)
  registro_id      BigInt?        @db.UnsignedBigInt
  datos_anteriores String?        @db.LongText
  datos_nuevos     String?        @db.LongText
  ip_address       String?        @db.VarChar(45)
  user_agent       String?        @db.VarChar(500)
  creado_en        DateTime       @default(now()) @db.Timestamp(0)
  usuarios_admin   UsuariosAdmin? @relation(fields: [id_usuario_admin], references: [idUsuario], onDelete: Restrict, onUpdate: Restrict, map: "fk_auditoria_admin")

  @@index([accion], map: "idx_auditoria_accion")
  @@index([id_usuario_admin, creado_en], map: "idx_auditoria_admin_fecha")
  @@index([tabla_afectada, registro_id], map: "idx_auditoria_tabla_registro")
}

model canjes_recompensas {
  id_canje           BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  id_clienta         BigInt                    @db.UnsignedBigInt
  id_recompensa      BigInt                    @db.UnsignedBigInt
  id_usuario_admin   BigInt                    @db.UnsignedBigInt
  puntos_utilizados  Int                       @db.UnsignedInt
  codigo_canje       String                    @unique(map: "uk_canjes_codigo") @db.Char(12)
  estado             canjes_recompensas_estado @default(SOLICITADO)
  solicitado_en      DateTime                  @default(now()) @db.Timestamp(0)
  entregado_en       DateTime?                 @db.DateTime(0)
  observaciones      String?                   @db.VarChar(500)
  usuarios_admin     UsuariosAdmin             @relation(fields: [id_usuario_admin], references: [idUsuario], onUpdate: Restrict, map: "fk_canjes_admin")
  clientas           clientas                  @relation(fields: [id_clienta], references: [id_clienta], onUpdate: Restrict, map: "fk_canjes_clienta")
  recompensas        recompensas               @relation(fields: [id_recompensa], references: [id_recompensa], onUpdate: Restrict, map: "fk_canjes_recompensa")
  movimientos_puntos movimientos_puntos[]

  @@index([id_usuario_admin], map: "idx_canjes_admin")
  @@index([id_clienta, solicitado_en], map: "idx_canjes_clienta_fecha")
  @@index([estado], map: "idx_canjes_estado")
  @@index([id_recompensa], map: "idx_canjes_recompensa")
}

model clientas {
  id_clienta            BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  public_id             String                 @unique(map: "uk_clientas_public_id") @db.Char(36)
  nombres               String                 @db.VarChar(100)
  apellidos             String                 @db.VarChar(100)
  telefono              String?                @db.VarChar(20)
  fecha_nacimiento      DateTime?              @db.Date
  puntos_saldo          Int                    @default(0) @db.UnsignedInt
  estado                clientas_estado        @default(ACTIVA)
  creado_en             DateTime               @default(now()) @db.Timestamp(0)
  actualizado_en        DateTime               @default(now()) @db.Timestamp(0)
  canjes_recompensas    canjes_recompensas[]
  credenciales_clientas credenciales_clientas?
  movimientos_puntos    movimientos_puntos[]
  qr_clientas           qr_clientas[]
  servicios_realizados  servicios_realizados[]
  sesiones_clientas     sesiones_clientas[]

  @@index([apellidos, nombres], map: "idx_clientas_apellidos_nombres")
  @@index([estado], map: "idx_clientas_estado")
  @@index([telefono], map: "idx_clientas_telefono")
}

model credenciales_clientas {
  id_credencial       BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  id_clienta          BigInt                       @unique(map: "uk_credenciales_clienta") @db.UnsignedBigInt
  email               String                       @unique(map: "uk_credenciales_email") @db.VarChar(150)
  password_hash       String                       @db.VarChar(255)
  email_verificado_en DateTime?                    @db.DateTime(0)
  ultimo_acceso_en    DateTime?                    @db.DateTime(0)
  estado              credenciales_clientas_estado @default(ACTIVA)
  creado_en           DateTime                     @default(now()) @db.Timestamp(0)
  actualizado_en      DateTime                     @default(now()) @db.Timestamp(0)
  clientas            clientas                     @relation(fields: [id_clienta], references: [id_clienta], onUpdate: Restrict, map: "fk_credenciales_clienta")
}

model movimientos_puntos {
  id_movimiento         BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  id_clienta            BigInt                  @db.UnsignedBigInt
  id_servicio_realizado BigInt?                 @db.UnsignedBigInt
  id_canje              BigInt?                 @db.UnsignedBigInt
  id_usuario_admin      BigInt?                 @db.UnsignedBigInt
  tipo                  movimientos_puntos_tipo
  puntos                Int
  saldo_anterior        Int                     @db.UnsignedInt
  saldo_posterior       Int                     @db.UnsignedInt
  descripcion           String?                 @db.VarChar(255)
  creado_en             DateTime                @default(now()) @db.Timestamp(0)
  usuarios_admin        UsuariosAdmin?          @relation(fields: [id_usuario_admin], references: [idUsuario], onDelete: Restrict, onUpdate: Restrict, map: "fk_mp_admin")
  canjes_recompensas    canjes_recompensas?     @relation(fields: [id_canje], references: [id_canje], onDelete: Restrict, onUpdate: Restrict, map: "fk_mp_canje")
  clientas              clientas                @relation(fields: [id_clienta], references: [id_clienta], onUpdate: Restrict, map: "fk_mp_clienta")
  servicios_realizados  servicios_realizados?   @relation(fields: [id_servicio_realizado], references: [id_servicio_realizado], onDelete: Restrict, onUpdate: Restrict, map: "fk_mp_servicio")

  @@index([id_usuario_admin], map: "idx_mp_admin")
  @@index([id_canje], map: "idx_mp_canje")
  @@index([id_clienta, creado_en], map: "idx_mp_clienta_fecha")
  @@index([id_servicio_realizado], map: "idx_mp_servicio")
  @@index([tipo], map: "idx_mp_tipo")
}

model permisos {
  id_permiso   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  codigo       String         @unique(map: "uk_permisos_codigo") @db.VarChar(100)
  nombre       String         @db.VarChar(100)
  descripcion  String?        @db.VarChar(255)
  rol_permisos rol_permisos[]
}

model qr_clientas {
  id_qr         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_clienta    BigInt    @db.UnsignedBigInt
  token_hash    String    @unique(map: "uk_qr_token_hash") @db.Char(64)
  activo        Boolean   @default(true)
  expira_en     DateTime? @db.DateTime(0)
  ultimo_uso_en DateTime? @db.DateTime(0)
  creado_en     DateTime  @default(now()) @db.Timestamp(0)
  revocado_en   DateTime? @db.DateTime(0)
  clientas      clientas  @relation(fields: [id_clienta], references: [id_clienta], onUpdate: Restrict, map: "fk_qr_clienta")

  @@index([activo], map: "idx_qr_activo")
  @@index([id_clienta], map: "idx_qr_clienta")
}

model recompensas {
  id_recompensa      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  nombre             String               @db.VarChar(150)
  descripcion        String?              @db.Text
  puntos_requeridos  Int                  @db.UnsignedInt
  stock              Int?                 @db.UnsignedInt
  limite_por_clienta Int?                 @db.UnsignedInt
  estado             recompensas_estado   @default(ACTIVA)
  creado_en          DateTime             @default(now()) @db.Timestamp(0)
  actualizado_en     DateTime             @default(now()) @db.Timestamp(0)
  canjes_recompensas canjes_recompensas[]

  @@index([estado], map: "idx_recompensas_estado")
  @@index([puntos_requeridos], map: "idx_recompensas_puntos")
}

model rol_permisos {
  id_rol     BigInt   @db.UnsignedBigInt
  id_permiso BigInt   @db.UnsignedBigInt
  permisos   permisos @relation(fields: [id_permiso], references: [id_permiso], onUpdate: Restrict, map: "fk_rol_permisos_permiso")
  roles      roles    @relation(fields: [id_rol], references: [id_rol], onUpdate: Restrict, map: "fk_rol_permisos_rol")

  @@id([id_rol, id_permiso])
  @@index([id_permiso], map: "fk_rol_permisos_permiso")
}

model roles {
  id_rol         BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  nombre         String          @unique(map: "uk_roles_nombre") @db.VarChar(50)
  descripcion    String?         @db.VarChar(255)
  estado         roles_estado    @default(ACTIVO)
  creado_en      DateTime        @default(now()) @db.Timestamp(0)
  actualizado_en DateTime        @default(now()) @db.Timestamp(0)
  rol_permisos   rol_permisos[]
  usuarios_admin UsuariosAdmin[]
}

model servicios {
  id_servicio          BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  nombre               String                 @db.VarChar(150)
  descripcion          String?                @db.Text
  precio               Decimal                @default(0.00) @db.Decimal(10, 2)
  puntos_otorgados     Int                    @default(0) @db.UnsignedInt
  estado               servicios_estado       @default(ACTIVO)
  creado_en            DateTime               @default(now()) @db.Timestamp(0)
  actualizado_en       DateTime               @default(now()) @db.Timestamp(0)
  servicios_realizados servicios_realizados[]

  @@index([estado], map: "idx_servicios_estado")
  @@index([nombre], map: "idx_servicios_nombre")
}

model servicios_realizados {
  id_servicio_realizado BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  id_clienta            BigInt                      @db.UnsignedBigInt
  id_servicio           BigInt                      @db.UnsignedBigInt
  id_usuario_admin      BigInt                      @db.UnsignedBigInt
  cantidad              Int                         @default(1) @db.UnsignedInt
  precio_unitario       Decimal                     @db.Decimal(10, 2)
  puntos_otorgados      Int                         @db.UnsignedInt
  idempotency_key       String                      @unique(map: "uk_sr_idempotency_key") @db.Char(36)
  observaciones         String?                     @db.VarChar(500)
  estado                servicios_realizados_estado @default(REGISTRADO)
  realizado_en          DateTime                    @default(now()) @db.DateTime(0)
  creado_en             DateTime                    @default(now()) @db.Timestamp(0)
  movimientos_puntos    movimientos_puntos[]
  usuarios_admin        UsuariosAdmin               @relation(fields: [id_usuario_admin], references: [idUsuario], onUpdate: Restrict, map: "fk_sr_admin")
  clientas              clientas                    @relation(fields: [id_clienta], references: [id_clienta], onUpdate: Restrict, map: "fk_sr_clienta")
  servicios             servicios                   @relation(fields: [id_servicio], references: [id_servicio], onUpdate: Restrict, map: "fk_sr_servicio")

  @@index([id_usuario_admin, realizado_en], map: "idx_sr_admin_fecha")
  @@index([id_clienta, realizado_en], map: "idx_sr_clienta_fecha")
  @@index([estado], map: "idx_sr_estado")
  @@index([id_servicio], map: "idx_sr_servicio")
}

model sesiones_clientas {
  id_sesion   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_clienta  BigInt    @db.UnsignedBigInt
  token_hash  String    @unique(map: "uk_sesiones_token_hash") @db.Char(64)
  expira_en   DateTime  @db.DateTime(0)
  revocada_en DateTime? @db.DateTime(0)
  creado_en   DateTime  @default(now()) @db.Timestamp(0)
  clientas    clientas  @relation(fields: [id_clienta], references: [id_clienta], onUpdate: Restrict, map: "fk_sesiones_clienta")

  @@index([id_clienta], map: "idx_sesiones_clienta")
  @@index([expira_en], map: "idx_sesiones_expira")
}

enum UsuariosAdminEstado {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum roles_estado {
  ACTIVO
  INACTIVO
}

enum servicios_estado {
  ACTIVO
  INACTIVO
}

enum movimientos_puntos_tipo {
  ACUMULACION
  CANJE
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  REVERSO
}

enum recompensas_estado {
  ACTIVA
  INACTIVA
}

enum credenciales_clientas_estado {
  ACTIVA
  INACTIVA
}

enum canjes_recompensas_estado {
  SOLICITADO
  ENTREGADO
  ANULADO
}

enum clientas_estado {
  ACTIVA
  INACTIVA
  BLOQUEADA
}

enum servicios_realizados_estado {
  REGISTRADO
  ANULADO
}
