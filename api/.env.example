NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/automot1_studios"

DB_HOST=localhost
DB_PORT=3306
DB_NAME=automot1_studios
DB_USER=DB_USER
DB_PASSWORD=DB_PASSWORD

# Orígenes del frontend Next.js (Vercel y/o dominio propio). Sin wildcard.
# Local: puerto del frontend (Next.js), no el de la API.
# Celular misma WiFi: http://TU_IP_LAN:3001 (ej. http://192.168.0.31:3001)
# En NODE_ENV=development la API también acepta orígenes LAN privados en :3001.
CORS_ORIGINS=http://localhost:3001,http://192.168.0.31:3001
CORS_ORIGIN=http://localhost:3001

JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_MIN_32_CHARS
JWT_EXPIRES_IN=8h

# Rate limit auth (fijo en código): 20 req / 15 min / IP en
# POST /auth/login, /auth/clienta/login, /auth/clienta/registro

# Solo para npm run admin:create (pasar password por shell en producción)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar_en_shell_min_12
ADMIN_NOMBRES=Nombre
ADMIN_APELLIDOS=Apellido
ADMIN_ID_ROL=1
